<?xml version="1.0"?>
<package format="2">
  <name>rrt3d_planner</name>
  <version>0.0.1</version>
  <description>3D Informed RRT* global planner plugin for ROS navigation</description>

  <maintainer email="erenogsuz99@gmail.com">Eren Ogsuz</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>pluginlib</depend>
  <depend>nav_core</depend>
  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>

  <export>
    <nav_core plugin="${prefix}/informed_rrt3d_plugin.xml"/>
    <pluginlib plugin="${prefix}/informed_rrt3d_plugin.xml"/>
  </export>
</package>
